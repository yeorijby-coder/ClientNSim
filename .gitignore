# 실행 로그 / 작업 산출물
*/Log/*.elg
*/Temp/
*/Job/
*/Stc/
# 빌드 산출물 : Bin/Debug 는 실행에 필요한 것만 넣는다.
#   앞의 */bin/debug/... 형태는 Bin/Debug 가 저장소 최상위라 걸리지 않는다.
#   (*/ 는 앞에 상위 폴더가 하나 있어야 매칭된다)
/Bin/Release/
/Bin/Debug/Builder/
/Bin/Debug/BuilderLib/
/Bin/Debug/CvSim/
/Bin/Debug/DciLib/
/Bin/Debug/Ecs/
/Bin/Debug/EcsLib/
/Bin/Debug/HostSim/
/Bin/Debug/HostSim_DB/
/Bin/Debug/ScSim/
/Bin/Debug/XmlLib/
# 디버그 심볼 / 브라우즈 정보 - 용량만 크고 실행에는 필요 없다
/Bin/Debug/*.pdb
/Bin/Debug/*.bsc
/Bin/Debug/*.map
/Bin/Debug/*.ilk
/Bin/Debug/*.exp
/Bin/Debug/*.lib
/Bin/Debug/*.RPT
ASSERT.LOG
*.dmp
# Tools\Deploy.ps1 가 만드는 배포 폴더
/Deploy/
